<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<OutputType>WinExe</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<MapFileExtensions>false</MapFileExtensions>
		<Install>false</Install>
		<IsWebBootstrapper>false</IsWebBootstrapper>

		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>

		<ApplicationIcon>Resources\EasyCPDLC.ico</ApplicationIcon>
		<StartupObject>EasyCPDLC.Program</StartupObject>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<NoWin32Manifest>true</NoWin32Manifest>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DefineConstants>
		</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<DebugType>none</DebugType>
		<DefineConstants>
		</DefineConstants>
	</PropertyGroup>
	<PropertyGroup>
		<ApplicationIcon>Resources\EasyCPDLC.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup>
		<StartupObject>EasyCPDLC.Program</StartupObject>
	</PropertyGroup>
	<PropertyGroup>
		<GenerateManifests>false</GenerateManifests>
	</PropertyGroup>
	<PropertyGroup>
		<SignManifests>false</SignManifests>
	</PropertyGroup>
	<PropertyGroup>
		<Win32Resource>
		</Win32Resource>
	</PropertyGroup>
	<PropertyGroup>
		<NoWin32Manifest>true</NoWin32Manifest>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="Resources\B612Mono-Bold.ttf" />
	</ItemGroup>
	<ItemGroup>
		<!--
			SimConnect.dll is the MSFS client library the VNS430 companion bridge P/Invokes.
			It is not on the PATH of a normal machine and MSFS does not publish it anywhere
			the loader looks, so without shipping it next to the executable every
			SimConnect_* call throws DllNotFoundException. That is swallowed by
			Vns430CompanionInput.TryEnable, which reports the module as "not detected" -
			the hardware bridge then silently does nothing on every machine.
		-->
		<Content Include="Runtime\SimConnect.dll" Link="SimConnect.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\Shared\VpilotBridgeProtocol.cs" Link="VPilotBridge\VpilotBridgeProtocol.cs" />
		<Compile Include="..\Shared\VpilotContactMeParser.cs" Link="VPilotBridge\VpilotContactMeParser.cs" />
		<Compile Update="CPDLCMessage.cs">
			<SubType>Component</SubType>
		</Compile>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
		<Compile Update="UITextBox.cs">
			<SubType>Component</SubType>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="FSUIPCClientDLL" Version="3.2.11" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="NLog" Version="6.1.3" />
		<PackageReference Include="Octokit" Version="0.50.0" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
		<None Update="Resources\cog-wheel-gear-setting.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Remove="VNS430\MSFS2024Module\MobiFlight\EasyCPDLC-VNS430-Module.mfproj" />
		<None Remove="VNS430\MSFS2024Module\MobiFlight\EasyCPDLC-DCDU-Module.mfproj" />
		<None Remove="VNS430\MSFS2024Module\MobiFlight\EasyCPDLC-WinWing-737-CDU.mfproj" />
		<None Include="VNS430\MSFS2024Module\MobiFlight\EasyCPDLC-VNS430-Module.mfproj">
			<TargetPath>MobiFlight\EasyCPDLC-VNS430-Module.mfproj</TargetPath>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="VNS430\MSFS2024Module\MobiFlight\EasyCPDLC-DCDU-Module.mfproj">
			<TargetPath>MobiFlight\EasyCPDLC-DCDU-Module.mfproj</TargetPath>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<!-- The 737 CDU profile is the primary hardware binding for the CDU instrument. -->
		<None Include="VNS430\MSFS2024Module\MobiFlight\EasyCPDLC-WinWing-737-CDU.mfproj">
			<TargetPath>MobiFlight\EasyCPDLC-WinWing-737-CDU.mfproj</TargetPath>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
		<None Update="Resources\cog-wheel-gear-setting.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- Publish as a real single-file app: assets are embedded, not copied next to the EXE. -->
	<ItemGroup>
		<Content Remove="Resources\**\*.*" />
		<Content Remove="Sounds\**\*.*" />
		<Content Remove="EZCPDLCIcon_64.ico" />
		<None Remove="Resources\**\*.*" />
		<None Include="Resources\EasyCPDLC.ico" />
		<None Remove="Sounds\**\*.*" />
		<None Remove="EZCPDLCIcon_64.ico" />

		<EmbeddedResource Include="Resources\**\*.*" Exclude="Resources\*.resx" />
		<EmbeddedResource Include="Sounds\**\*.*" />
		<EmbeddedResource Include="*.ico" />
		<EmbeddedResource Include="VNS430\Assets\**\*.*" />
	</ItemGroup>

</Project>
